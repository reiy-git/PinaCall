# Production: set this to the public HTTPS origin students will open.
# QR URLs are embedded in the frontend build, so set this before building.
VITE_PUBLIC_APP_URL=https://portal.example.com

# Prefer a same-origin reverse proxy from /api to the Laravel API.
VITE_API_BASE_URL=/api

# Vite development-server settings only; do not use Vite as the production server.
VITE_DEV_HOST=127.0.0.1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
